<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console test runner (no xunit, no NuGet). Compiles the app's Program.cs directly
       so the tests hit the exact file/vdf logic that ships. Run:  dotnet run  (from this folder) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clonedivers.Tests</RootNamespace>
    <StartupObject>Clonedivers.Tests.TestProgram</StartupObject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-clones-r20.json" LogicalName="Clonedivers.HellForge.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r48.json" LogicalName="Clonedivers.HellForge.Empire.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-r19.json" LogicalName="Clonedivers.Tests.Clones.R19.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r47.json" LogicalName="Clonedivers.Tests.Empire.R47.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r47-lighter.json" LogicalName="Clonedivers.Tests.Empire.R47.Lighter.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r45-v4.json" LogicalName="Clonedivers.Tests.Empire.R45.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r46.json" LogicalName="Clonedivers.Tests.Empire.R46.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r46-lighter.json" LogicalName="Clonedivers.Tests.Empire.R46.Lighter.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r45-v4-lighter.json" LogicalName="Clonedivers.Tests.Empire.R45.Lighter.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/forge-gameplay-build25480438-r7.json" LogicalName="Clonedivers.Forge.Gameplay.json" />
    <EmbeddedResource Include="../forge-mods/clean-exit/hellforge-mod.json" LogicalName="Clonedivers.Tests.CleanExit.json" />
    <EmbeddedResource Include="../forge-mods/lego-compact-leaf-writer/hellforge-mod.json" LogicalName="Clonedivers.Tests.LegoCompactLeafWriter.json" />
    <EmbeddedResource Include="../forge-mods/empire-lego-yoda/hellforge-mod.json" LogicalName="Clonedivers.Tests.EmpireLegoYoda.json" />
    <EmbeddedResource Include="../forge-mods/empire-atst-writer/hellforge-mod.json" LogicalName="Clonedivers.Tests.EmpireAtstWriter.json" />
    <EmbeddedResource Include="../forge-mods/empire-tie-switch/hellforge-mod.json" LogicalName="Clonedivers.Tests.EmpireTieSwitch.json" />
    <EmbeddedResource Include="../forge-mods/chaos-invasions/hellforge-mod.json" LogicalName="Clonedivers.Tests.ChaosInvasions.json" />
    <Compile Include="..\Clonedivers\*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\Clonedivers\Ui\*.cs" Link="Ui\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

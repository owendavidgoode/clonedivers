<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console test runner (no xunit, no NuGet). Compiles the app's Program.cs directly
       so the tests hit the exact file/vdf logic that ships. Run:  dotnet run  (from this folder) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clonedivers.Tests</RootNamespace>
    <StartupObject>Clonedivers.Tests.TestProgram</StartupObject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-r19.json" LogicalName="Clonedivers.HellForge.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r47-full.json" LogicalName="Clonedivers.HellForge.Empire.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r45-v4.json" LogicalName="Clonedivers.Tests.Empire.R45.Published.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r46.json" LogicalName="Clonedivers.Tests.Empire.R46.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r46-lighter.json" LogicalName="Clonedivers.Tests.Empire.R46.Lighter.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r45-v4-lighter.json" LogicalName="Clonedivers.Tests.Empire.R45.Lighter.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/forge-gameplay-build25480438-r3.json" LogicalName="Clonedivers.Forge.Gameplay.json" />
    <EmbeddedResource Include="../forge-mods/clean-exit/hellforge-mod.json" LogicalName="Clonedivers.Tests.CleanExit.json" />
    <Compile Include="..\Clonedivers\*.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

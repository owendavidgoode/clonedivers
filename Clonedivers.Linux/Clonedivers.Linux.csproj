<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>clonedivers</AssemblyName>
    <Version>0.5.0</Version>
    <ForgeEdition Condition="'$(ForgeEdition)' == ''">true</ForgeEdition>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ForgeEdition)' == 'true'">
    <Version>0.8.0</Version>
    <DefineConstants>$(DefineConstants);FORGE_DEFAULT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <InternalsVisibleTo Include="Clonedivers.Linux.Tests" />
    <InternalsVisibleTo Include="Clonedivers.ForgePreview" />
    <EmbeddedResource Include="clonedivers.svg" LogicalName="Clonedivers.desktop.svg" />
    <Compile Include="../Clonedivers/PackCore.cs" Link="Core/PackCore.cs" />
    <Compile Include="../Clonedivers/ModeSelection.cs" Link="Core/ModeSelection.cs" />
    <Compile Include="../Clonedivers/LinuxPlatform.cs" Link="Core/LinuxPlatform.cs" />
    <Compile Include="../Clonedivers/PackOperations.cs" Link="Core/PackOperations.cs" />
    <Compile Include="../Clonedivers/PackExtras.cs" Link="Core/PackExtras.cs" />
    <Compile Include="../Clonedivers/PackProfiles.cs" Link="Core/PackProfiles.cs" />
    <Compile Include="../Clonedivers/ManifestStore.cs" Link="Core/ManifestStore.cs" />
    <Compile Include="../Clonedivers/TelemetryStore.cs" Link="Core/TelemetryStore.cs" />
    <Compile Include="../Clonedivers/FpvDefaults.cs" Link="Core/FpvDefaults.cs" />
    <Compile Include="../Clonedivers/HellForgeModels.cs" Link="Core/HellForgeModels.cs" />
    <Compile Include="../Clonedivers/HellForgePreset.cs" Link="Core/HellForgePreset.cs" />
    <Compile Include="../Clonedivers/HellForgePack.cs" Link="Core/HellForgePack.cs" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-r19.json" LogicalName="Clonedivers.HellForge.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r47.json" LogicalName="Clonedivers.HellForge.Empire.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r47-lighter.json" LogicalName="Clonedivers.HellForge.Empire.Lighter.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/forge-gameplay-build25480438-r3.json" LogicalName="Clonedivers.Forge.Gameplay.json" />
    <Compile Include="../Clonedivers/HellForgeGameplayCatalog.cs" Link="Core/HellForgeGameplayCatalog.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>clonedivers</AssemblyName>
    <Version>0.5.0</Version>
    <ForgeEdition Condition="'$(ForgeEdition)' == ''">true</ForgeEdition>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ForgeEdition)' == 'true'">
    <Version>0.10.0</Version>
    <DefineConstants>$(DefineConstants);FORGE_DEFAULT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <InternalsVisibleTo Include="Clonedivers.Linux.Tests" />
    <InternalsVisibleTo Include="Clonedivers.ForgePreview" />
    <EmbeddedResource Include="clonedivers.svg" LogicalName="Clonedivers.desktop.svg" />
    <EmbeddedResource Include="../Clonedivers/clonedivers.ico" LogicalName="Clonedivers.Icon.ico" />
    <Compile Include="../Clonedivers/PackCore.cs" Link="Core/PackCore.cs" />
    <Compile Include="../Clonedivers/ModeSelection.cs" Link="Core/ModeSelection.cs" />
    <Compile Include="../Clonedivers/LinuxPlatform.cs" Link="Core/LinuxPlatform.cs" />
    <Compile Include="../Clonedivers/PackOperations.cs" Link="Core/PackOperations.cs" />
    <Compile Include="../Clonedivers/PackExtras.cs" Link="Core/PackExtras.cs" />
    <Compile Include="../Clonedivers/PackProfiles.cs" Link="Core/PackProfiles.cs" />
    <Compile Include="../Clonedivers/ManifestStore.cs" Link="Core/ManifestStore.cs" />
    <Compile Include="../Clonedivers/TelemetryStore.cs" Link="Core/TelemetryStore.cs" />
    <Compile Include="../Clonedivers/FpvDefaults.cs" Link="Core/FpvDefaults.cs" />
    <Compile Include="../Clonedivers/HellForgeModels.cs" Link="Core/HellForgeModels.cs" />
    <Compile Include="../Clonedivers/HellForgePreset.cs" Link="Core/HellForgePreset.cs" />
    <Compile Include="../Clonedivers/HellForgePack.cs" Link="Core/HellForgePack.cs" />
    <Compile Include="../Clonedivers/OperationProgress.cs" Link="Core/OperationProgress.cs" />
    <Compile Include="../Clonedivers/Ui/ForgeTheme.cs" Link="Ui/ForgeTheme.cs" />
    <Compile Include="../Clonedivers/Ui/ForgeUiModels.cs" Link="Ui/ForgeUiModels.cs" />
    <Compile Include="../Clonedivers/Ui/ForgeShellWindow.cs" Link="Ui/ForgeShellWindow.cs" />
    <Compile Include="../Clonedivers/Ui/WindowsTaskbar.cs" Link="Ui/WindowsTaskbar.cs" />
    <Compile Include="../Clonedivers/Ui/PreviewForgeHost.cs" Link="Ui/PreviewForgeHost.cs" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-clones-r21.json" LogicalName="Clonedivers.HellForge.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/hellforge-empire-r49.json" LogicalName="Clonedivers.HellForge.Empire.Manifest.json" />
    <EmbeddedResource Include="../Clonedivers/Resources/forge-gameplay-build25480438-r8.json" LogicalName="Clonedivers.Forge.Gameplay.json" />
    <Compile Include="../Clonedivers/HellForgeGameplayCatalog.cs" Link="Core/HellForgeGameplayCatalog.cs" />
    <Compile Include="../Clonedivers/PerformanceTierAdvisor.cs" Link="Core/PerformanceTierAdvisor.cs" />
    <Compile Include="../Clonedivers/ForgeDiskManager.cs" Link="Core/ForgeDiskManager.cs" />
    <Compile Include="../Clonedivers/SquadFingerprint.cs" Link="Core/SquadFingerprint.cs" />
    <Compile Include="../Clonedivers/CrashTriage.cs" Link="Core/CrashTriage.cs" />
    <Compile Include="../Clonedivers/HostMutatorConfig.cs" Link="Core/HostMutatorConfig.cs" />
    <Compile Include="../Clonedivers/DiscordRpcClient.cs" Link="Core/DiscordRpcClient.cs" />
    <Compile Include="../Clonedivers/SquadReportClient.cs" Link="Core/SquadReportClient.cs" />
    <Compile Include="../Clonedivers/WhatsNewFetcher.cs" Link="Core/WhatsNewFetcher.cs" />
    <Compile Include="../Clonedivers/DiscordReportFormatter.cs" Link="Core/DiscordReportFormatter.cs" />
    <Compile Include="../Clonedivers/Ui/UiSoundEffects.cs" Link="Ui/UiSoundEffects.cs" />
  </ItemGroup>
</Project>
